[
  {
    // Id: passo único dentro do fluxo. Usado como "step".
    "Id": 1,

    // Type: tipo do item do fluxo
    // 1=Text (pergunta/mensagem), 2=BackgoundProcess, 3=Options, 5=SupportTicket, 6=EndConversation, 7=Proxy
    "Type": 3, // Options

    // Startup: se true, é o primeiro passo do fluxo
    "Startup": true,

    // Description: descrição funcional do passo
    "Description": "Menu inicial",

    // Messages: mensagens enviadas ao usuário neste passo (na ordem)
    "Messages": [
      { "Order": 1, "Text": "Olá! Sou sua assistente virtual.", "Type": "text" }, // Type: "text" ou "template"
      { "Order": 2, "Text": "Como posso ajudar hoje?", "Type": "text" },
      { "Order": 3, "Text": "1 - Consultar cadastro\n2 - Simular crédito\n9 - Falar com atendente", "Type": "text" }
    ],

    // Failures: regras de falha específicas do passo (ex.: opção inválida)
    "Failures": [
      {
        // ErrorCode: código interno para identificar a falha (ex.: option.not.found)
        "ErrorCode": "option.not.found",
        // ErrorMessage: mensagens retornadas ao usuário quando a falha ocorre
        "ErrorMessage": ["Opção inválida. Digite 1, 2 ou 9."],
        // MaxRetries: número de tentativas antes de acionar fallback
        "MaxRetries": 3,
        // ReturnToPreviousState: se true, volta ao passo anterior ao exceder tentativas
        "ReturnToPreviousState": false,
        // IgnoreErrorMessage: se true, não envia as mensagens de erro
        "IgnoreErrorMessage": false,
        // FlowItemWhenMaxRetriesExceeded: passo de fallback quando excede tentativas
        "FlowItemWhenMaxRetriesExceeded": 99
      }
    ],

    // NextFlow: regras para decidir o próximo passo a partir de condições
    "NextFlow": {
      "Options": [
        {
          // 1 => consultar cadastro (perguntar CPF)
          "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["1"] } ],
          "FlowItemId": 2
        },
        {
          // 2 => simular crédito (menu de produtos)
          "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["2"] } ],
          "FlowItemId": 10
        },
        {
          // 9 => falar com atendente
          "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["9"] } ],
          "FlowItemId": 90
        }
      ]
    },

    // Metadata: metadados livres para o passo (chave/valor)
    "Metadata": null,

    // OutputActions: validações/ações de saída antes de avançar (opcional)
    // Cada ação tem: Key (tipo/validador), Conditions (strings específicas), Parameter (parametro), Failure (falha quando não passar)
    "OutputActions": null,

    // Campos para processos assíncronos (BackgroundProcess/SupportTicket/Proxy). Quando Type=2/5/7, podem ser usados:
    // RequestContent: payload para publicar no tópico (valores podem referenciar contexto, ex.: "context.question.2")
    "RequestContent": null,
    // ResponseContent: mapeamento esperado de retorno (se aplicável)
    "ResponseContent": null,
    // TopicName: tópico para publicar a solicitação
    "TopicName": null,
    // SubscriptionName: assinatura que escuta a resposta
    "SubscriptionName": null,
    // SubscriptionTopicName: tópico do retorno
    "SubscriptionTopicName": null
  },

  {
    "Id": 2,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Perguntar CPF",
    "Messages": [
      { "Order": 1, "Text": "Informe seu CPF (apenas números):", "Type": "text" }
    ],
    "Failures": [
      {
        "ErrorCode": "cpf.invalid",
        "ErrorMessage": ["CPF inválido. Tente novamente."],
        "MaxRetries": 3,
        "ReturnToPreviousState": false,
        "IgnoreErrorMessage": false,
        "FlowItemWhenMaxRetriesExceeded": 1
      }
    ],
    "NextFlow": {
      "Options": [
        // HasValue: segue se o usuário informou algo
        { "Conditions": [{ "Source": "input", "Comparison": 1 }], "FlowItemId": 3 }
      ]
    },
    "Metadata": null,
    "OutputActions": null,
    "RequestContent": null,
    "ResponseContent": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 3,
    "Type": 2, // BackgoundProcess
    "Startup": false,
    "Description": "Consultar cooperado por CPF (assíncrono)",
    "Messages": null,
    "Failures": [
      {
        "ErrorCode": "record.not.found",
        "ErrorMessage": [],
        "MaxRetries": 0,
        "ReturnToPreviousState": false,
        "IgnoreErrorMessage": true,
        "FlowItemWhenMaxRetriesExceeded": 5
      }
    ],
    "NextFlow": {
      "Options": [
        // Se veio id no retorno, segue para 4; caso contrário, 5
        { "Conditions": [{ "Source": "context.question.3.id", "Comparison": 1 }], "FlowItemId": 4 },
        { "Conditions": [{ "Source": "context.question.3.id", "Comparison": 4 }], "FlowItemId": 5 }
      ]
    },
    // Mapeia parâmetros de entrada da publicação (placeholders do contexto)
    "RequestContent": {
      "CPF": "context.question.2",
      "UsuarioId": "conversation.userId"
    },
    "ResponseContent": {},
    "TopicName": "chatbot_consultar_cooperado",
    "SubscriptionName": "chatbot",
    "SubscriptionTopicName": "chatbot_consultar_cooperado_result",
    "Metadata": null,
    "OutputActions": null
  },

  {
    "Id": 4,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Cadastro encontrado",
    "Messages": [
      { "Order": 1, "Text": "Cadastro localizado! Nome: {{question.3.nome}}", "Type": "template" }
    ],
    "NextFlow": {
      // Após exibir a confirmação, segue para o menu de produtos
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 10 } ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 5,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Cadastro não encontrado",
    "Messages": [
      { "Order": 1, "Text": "Não encontrei seu cadastro. Deseja tentar novamente mais tarde.", "Type": "text" }
    ],
    "NextFlow": {
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 99 } ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 10,
    "Type": 3, // Options
    "Startup": false,
    "Description": "Menu de produtos",
    "Messages": [
      { "Order": 1, "Text": "1 - Simular crédito pessoal\n2 - Limite de crédito\n9 - Voltar ao atendente", "Type": "text" }
    ],
    "Failures": [
      {
        "ErrorCode": "option.not.found",
        "ErrorMessage": ["Opção inválida. Digite 1, 2 ou 9."],
        "MaxRetries": 3,
        "ReturnToPreviousState": false,
        "IgnoreErrorMessage": false,
        "FlowItemWhenMaxRetriesExceeded": 99
      }
    ],
    "NextFlow": {
      "Options": [
        { "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["1"] } ], "FlowItemId": 11 },
        { "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["2"] } ], "FlowItemId": 20 },
        { "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["9"] } ], "FlowItemId": 90 }
      ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 11,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Perguntar valor da simulação",
    "Messages": [
      { "Order": 1, "Text": "Informe o valor desejado (mínimo R$ 100):", "Type": "text" }
    ],
    "NextFlow": {
      "Options": [
        // Input <= 99 => permanece no 11 (repergunta)
        { "Conditions": [ { "Source": "input", "Comparison": 11, "Values": ["99"] } ], "FlowItemId": 11 },
        // Input >= 100 => segue para simulação
        { "Conditions": [ { "Source": "input", "Comparison": 10, "Values": ["100"] } ], "FlowItemId": 12 }
      ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 12,
    "Type": 2, // BackgoundProcess
    "Startup": false,
    "Description": "Simular proposta (assíncrono)",
    "Messages": null,
    "NextFlow": {
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 13 } ]
    },
    "RequestContent": {
      "CPF": "context.question.2",
      "ValorSolicitado": "context.question.11",
      "UsuarioId": "conversation.userId"
    },
    "ResponseContent": {},
    "TopicName": "chatbot_simular_proposta",
    "SubscriptionName": "chatbot",
    "SubscriptionTopicName": "chatbot_simular_proposta_result",
    "Metadata": null,
    "OutputActions": null
  },

  {
    "Id": 13,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Apresentar proposta e perguntar próximo passo",
    "Messages": [
      { "Order": 1, "Text": "Resultado da simulação: valor {{question.12.valorAprovado}}, parcelas {{question.12.qtdParcelas}}.", "Type": "template" },
      { "Order": 2, "Text": "1 - Confirmar e abrir ticket\n2 - Refazer a simulação", "Type": "text" }
    ],
    "Failures": [
      {
        "ErrorCode": "option.not.found",
        "ErrorMessage": [ "Opção inválida. Digite 1 ou 2." ],
        "MaxRetries": 3,
        "ReturnToPreviousState": false,
        "IgnoreErrorMessage": false,
        "FlowItemWhenMaxRetriesExceeded": 99
      }
    ],
    "NextFlow": {
      "Options": [
        { "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["1"] } ], "FlowItemId": 14 },
        { "Conditions": [ { "Source": "input", "Comparison": 2, "Values": ["2"] } ], "FlowItemId": 10 }
      ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 14,
    "Type": 5, // SupportTicket (BackgroundProcess estendido)
    "Startup": false,
    "Description": "Abrir ticket de suporte",
    "Messages": null,
    "NextFlow": {
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 15 } ]
    },
    "RequestContent": {
      "CPF": "context.question.2",
      "ValorAprovado": "context.question.12.valorAprovado",
      "UsuarioId": "conversation.userId"
    },
    "ResponseContent": {},
    "TopicName": "chatbot_criar_ticket",
    "SubscriptionName": "chatbot",
    "SubscriptionTopicName": "chatbot_criar_ticket_result",
    "Metadata": null,
    "OutputActions": null
  },

  {
    "Id": 15,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Confirmação de ticket e encerramento",
    "Messages": [
      { "Order": 1, "Text": "Ticket criado com sucesso! Número {{question.14.ticketId}}.", "Type": "template" },
      { "Order": 2, "Text": "Encerrando atendimento. Obrigado!", "Type": "text" }
    ],
    "NextFlow": {
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 99 } ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 20,
    "Type": 1, // Text
    "Startup": false,
    "Description": "Limite de crédito indisponível",
    "Messages": [
      { "Order": 1, "Text": "Consulta de limite de crédito indisponível no momento.", "Type": "text" }
    ],
    "NextFlow": { "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 99 } ] },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 90,
    "Type": 7, // Proxy
    "Startup": false,
    "Description": "Encaminhar para atendente (proxy)",
    "Messages": [
      { "Order": 1, "Text": "Transferindo para um atendente humano. Aguarde um instante…", "Type": "text" }
    ],
    "NextFlow": {
      "Options": [ { "Conditions": [ { "Source": "input", "Comparison": 3 } ], "FlowItemId": 99 } ]
    },
    "Metadata": null,
    "RequestContent": null,
    "ResponseContent": null,
    "OutputActions": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  },

  {
    "Id": 99,
    "Type": 6, // EndConversation
    "Startup": false,
    "Description": "Encerrar conversa",
    "Messages": [
      { "Order": 1, "Text": "Atendimento encerrado. Até logo!", "Type": "text" }
    ],
    "NextFlow": null,
    "Metadata": null,
    "OutputActions": null,
    "RequestContent": null,
    "ResponseContent": null,
    "TopicName": null,
    "SubscriptionName": null,
    "SubscriptionTopicName": null
  }
]
